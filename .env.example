# ==============================================================================
# MRD TOOL CONTROL -- Variables de entorno
# Sprint 5.8 IASMRD Cloudflare Deployment
#
# INSTRUCCIONES:
#   1. Copia este archivo como config/local.env
#   2. Rellena los valores obligatorios (marcados con *)
#   3. Ejecuta generate_secrets.ps1 para generar las claves automaticamente
#   4. NUNCA subas config/local.env al repositorio de codigo
# ==============================================================================

# -- Entorno -------------------------------------------------------------------
# "development" | "production"
# En produccion: SECRET_KEY obligatoria, contrasenas mas estrictas, cookies Secure
MRD_ENV=production

# -- Seguridad JWT * -----------------------------------------------------------
# * OBLIGATORIA en produccion. La app NO arrancara sin este valor.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# O ejecuta: generate_secrets.ps1
MRD_SECRET_KEY=

# -- Contrasena del administrador inicial * ------------------------------------
# Solo se usa en la PRIMERA creacion del admin.
# Si no se define, se genera automaticamente (visible en la consola al arrancar).
# El admin DEBE cambiar la contrasena en el primer inicio de sesion.
MRD_ADMIN_PASSWORD=

# -- Politica de contrasenas ---------------------------------------------------
# Minimo de caracteres (nunca inferior a 8; produccion minimo 10)
MRD_PASSWORD_MIN_LENGTH=10

# -- Subida de archivos --------------------------------------------------------
# Tamano maximo en MB
MRD_MAX_UPLOAD_MB=10

# -- Sesiones ------------------------------------------------------------------
# Duracion de la sesion en minutos (480 = 8 horas)
MRD_SESSION_MAX_AGE=43200

# -- Servidor ------------------------------------------------------------------
MRD_HOST=127.0.0.1
MRD_PORT=8000
MRD_LOG_LEVEL=warning

# -- HTTPS ---------------------------------------------------------------------
# Forzar cookies Secure=true aunque no venga X-Forwarded-Proto
MRD_HTTPS_ONLY=true

# -- IASMRD -- Dominio de produccion -------------------------------------------
# URL publica de la aplicacion (sin barra final)
MRD_PUBLIC_URL=https://app.tudominio.com
PUBLIC_URL=https://app.tudominio.com
MRD_BASE_DOMAIN=tudominio.com
MRD_APP_SUBDOMAIN=app
MRD_INTERNAL_HOST=127.0.0.1
MRD_INTERNAL_PORT=8000
MRD_INTERNAL_URL=http://127.0.0.1:8000
MRD_SCAN_URL=https://app.tudominio.com/scan

# -- Proxy inverso y cabeceras -------------------------------------------------
# true = confiar en X-Forwarded-Proto/For/Host de Cloudflare
MRD_TRUST_PROXY_HEADERS=true
# Hosts permitidos, separados por coma
MRD_ALLOWED_HOSTS=app.tudominio.com,localhost,127.0.0.1

# -- Cloudflare Tunnel ---------------------------------------------------------
MRD_REMOTE_PROVIDER=cloudflare
MRD_CLOUDFLARE_TUNNEL_TYPE=named
MRD_CLOUDFLARED_SERVICE_NAME=cloudflared
# NUNCA pongas aqui el token real del tunel; usa el servicio de Windows o
# la variable de entorno del sistema (cloudflared service install <TOKEN>)
